<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#A80F27">
<com.karen.assistant.WebBackdrop android:id="@+id/backdrop" android:layout_width="match_parent" android:layout_height="match_parent"/>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="22dp">
<Button android:id="@+id/modeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Spider Mode  ⇄  Iron Mode"/>
<ImageView android:id="@+id/avatar" android:layout_width="154dp" android:layout_height="154dp" android:layout_marginTop="20dp" android:src="@drawable/avatar_spider" android:contentDescription="Assistant emblem"/>
<TextView android:id="@+id/assistantTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KAREN" android:textColor="#FFFFFF" android:textSize="38sp" android:textStyle="bold" android:letterSpacing="0.12"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Я рядом. Что будем делать?" android:textColor="#FFFFFF" android:textSize="16sp"/>
<LinearLayout android:id="@+id/conversationCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_white" android:layout_marginTop="14dp" ><TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#501522" android:textSize="15sp" android:text="Нажмите микрофон или введите команду."/><TextView android:id="@+id/modelStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#501522" android:textSize="15sp" android:text="Встроенная модель голоса"/><Button android:id="@+id/voiceButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="●  ГОВОРИТЬ"/><EditText android:id="@+id/commandInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Введите команду…" android:textColor="#501522" android:textColorHint="#996D75" android:inputType="textCapSentences" android:maxLines="2"/><Button android:id="@+id/sendButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Выполнить"/></LinearLayout>
<Button android:id="@+id/controlsToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Управление телефоном  ▾"/>
<LinearLayout android:id="@+id/controlsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_white" android:layout_marginTop="14dp" android:visibility="gone"><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#501522" android:textSize="15sp" android:text="Громкость"/><SeekBar android:id="@+id/volumeSlider" android:layout_width="match_parent" android:layout_height="48dp" android:max="100"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#501522" android:textSize="15sp" android:text="Яркость"/><SeekBar android:id="@+id/brightnessSlider" android:layout_width="match_parent" android:layout_height="48dp" android:max="100"/><Button android:id="@+id/settingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Разрешить изменение яркости"/><Button android:id="@+id/appsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Открыть приложение"/><Button android:id="@+id/scanButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Все приложения"/><Button android:id="@+id/playButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Найти в Google Play"/><Button android:id="@+id/homeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Свернуть приложение"/><Button android:id="@+id/timeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Сколько времени?"/><Button android:id="@+id/shotButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Скриншот"/><Button android:id="@+id/recordButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Запись экрана"/><Button android:id="@+id/stopRecordButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Остановить запись"/></LinearLayout>
<Button android:id="@+id/settingsToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Настройки  ▾"/>
<LinearLayout android:id="@+id/settingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_white" android:layout_marginTop="14dp" android:visibility="gone"><Button android:id="@+id/overlayButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Плавающая кнопка"/><Button android:id="@+id/customButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Мои команды"/><Button android:id="@+id/importVoiceButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Голос из видео / аудио"/><Button android:id="@+id/voiceStyleButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Системный голос"/><Button android:id="@+id/ownerVoiceButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Только мой голос"/><Button android:id="@+id/audioAnswerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Аудиоответы для команд"/><Button android:id="@+id/searchAnswerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:backgroundTint="#C71932" android:textColor="#FFFFFF" android:text="Поиск ответа в интернете"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#501522" android:textSize="15sp" android:text="Видео: галерея или Telegram → Поделиться → Karen / Jarvis. Модели работают на телефоне; сходство и скорость экспериментальные. «Только мой голос» не защищает от записи голоса. Команда «закрой» сворачивает приложение."/></LinearLayout>
</LinearLayout></ScrollView></FrameLayout>
